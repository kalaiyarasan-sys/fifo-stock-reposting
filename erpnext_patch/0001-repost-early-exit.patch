+def make_manufacture_entry(ctx, bom, qty, posting_date):
+	se = frappe.new_doc("Stock Entry")
+	se.purpose = "Manufacture"
+	se.stock_entry_type = "Manufacture"
+	se.company = ctx.company
+	se.from_bom = 1
+	se.bom_no = bom
+	se.fg_completed_qty = qty
+	se.use_multi_level_bom = 0
+	se.from_warehouse = ctx.warehouse
+	se.to_warehouse = ctx.warehouse
+	se.set_posting_time = 1
+	se.posting_date = posting_date
+	se.posting_time = POSTING_TIME
+	se.get_items()
+	se.insert(ignore_permissions=True)
+	se.submit()
+	return se
