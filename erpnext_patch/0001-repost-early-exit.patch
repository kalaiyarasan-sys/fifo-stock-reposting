@@ -0,0 +1,415 @@
+# Tests for the early exit in update_entries_after (erpnext/stock/stock_ledger.py).
+#
+# The scenario is the Milk / Milk Powder task:
+#   01 Jan  opening       Milk +100 @ 50
+#   10 Jan  PR            Milk  +50 @ 60   (later corrected to 80 with a Landed Cost Voucher)
+#   15 Jan  DN            Milk  -80
+#   20 Jan  PR            Milk  +50 @ 60
+#   21 Jan  Manufacture   Milk -100 -> Milk Powder +10
+#   25 Jan  DN            Milk Powder -10
+#
+# The tests create their own items, supplier and customer in the default company,
+# so they do not need the _Test records of ERPNext.
+
+import json
+
+import frappe
+from frappe.tests.utils import FrappeTestCase
+from frappe.utils import add_days, flt, getdate
+
+import erpnext
+from erpnext.stock.doctype.stock_entry.stock_entry_utils import make_stock_entry
+
+POSTING_TIME = "10:00:00"
+SLE_FIELDS = (
+	"voucher_type",
+	"voucher_no",
+	"actual_qty",
+	"qty_after_transaction",
+	"incoming_rate",
+	"valuation_rate",
+	"stock_value",
+	"stock_value_difference",
+	"stock_queue",
+)
+
+
+class TestRepostEarlyExit(FrappeTestCase):
+	@classmethod
+	def setUpClass(cls):
+		super().setUpClass()
+		cls.ctx = get_context()
+
+	def tearDown(self):
+		frappe.flags.disable_repost_early_exit = False
+
+	def test_task_scenario_values_after_rate_change(self):
+		data = make_milk_scenario(self.ctx)
+		correct_rate_with_landed_cost(self.ctx, data.pr_10, 50 * 20)  # 60 -> 80
+
+		pr_10 = get_sle(data.pr_10.name, data.milk)
+		self.assertEqual(flt(pr_10.incoming_rate), 80)
+		self.assertEqual(flt(pr_10.stock_value), 9000)
+
+		# 15 Jan: cost stays 4000 (FIFO takes the opening layer @ 50), balance changes
+		dn_15 = get_sle(data.dn_15.name, data.milk)
+		self.assertEqual(flt(dn_15.stock_value_difference), -4000)
+		self.assertEqual(flt(dn_15.stock_value), 5000)
+
+		self.assertEqual(flt(get_sle(data.pr_20.name, data.milk).stock_value), 8000)
+
+		# 21 Jan: 20 @ 50 + 50 @ 80 + 30 @ 60 = 6800
+		milk_out = get_sle(data.mfg_21.name, data.milk)
+		self.assertEqual(flt(milk_out.stock_value_difference), -6800)
+		self.assertEqual(flt(milk_out.stock_value), 1200)
+
+		powder_in = get_sle(data.mfg_21.name, data.powder)
+		self.assertEqual(flt(powder_in.incoming_rate), 680)
+
+		self.assertEqual(flt(get_sle(data.dn_25.name, data.powder).stock_value_difference), -6800)
+
+	def test_early_exit_gives_same_ledger_as_full_repost(self):
+		self.skip_if_other_reposts_pending()
+
+		frappe.flags.disable_repost_early_exit = True
+		full = make_milk_scenario(self.ctx, extra_days=20)
+		full_run = correct_rate_with_landed_cost(self.ctx, full.pr_10, 1000)
+
+		frappe.flags.disable_repost_early_exit = False
+		early = make_milk_scenario(self.ctx, extra_days=20)
+		early_run = correct_rate_with_landed_cost(self.ctx, early.pr_10, 1000)
+
+		self.assertEqual(ledger_values(full.milk), ledger_values(early.milk))
+		self.assertEqual(ledger_values(full.powder), ledger_values(early.powder))
+
+		# 20 receipts and 20 deliveries of Milk come after the manufacture entry. They are skipped,
+		# except receipts when their rate can come from a Purchase Invoice (Buying Settings).
+		expected_skipped = 20 if landed_cost_based_on_purchase_invoice() else 40
+		trace = "\n".join(f"  {row}" for row in early_run.trace)
+		message = (
+			f"full repost: processed {full_run.processed}, skipped {full_run.skipped}\n"
+			f"early exit: processed {early_run.processed}, skipped {early_run.skipped}, "
+			f"enabled {early_run.early_exit_enabled}, pending {early_run.pending_reposts}\n"
+			f"stored state -> recalculated state:\n{trace}"
+		)
+		self.assertFalse(full_run.early_exit_enabled, message)
+		self.assertTrue(early_run.early_exit_enabled, message)
+		self.assertEqual(full_run.skipped, 0, message)
+		self.assertEqual(early_run.skipped, expected_skipped, message)
+		self.assertEqual(full_run.processed - early_run.processed, expected_skipped, message)
+
+	def test_return_after_convergence_is_still_reposted(self):
+		"""A purchase return takes its rate from the receipt, so it must be recalculated
+		even after Milk has converged."""
+		self.skip_if_other_reposts_pending()
+
+		frappe.flags.disable_repost_early_exit = True
+		full = make_milk_scenario(self.ctx, extra_days=5)
+		make_purchase_return(full.pr_10, qty=5, posting_date="2026-01-23")
+		correct_rate_with_landed_cost(self.ctx, full.pr_10, 1000)
+
+		frappe.flags.disable_repost_early_exit = False
+		early = make_milk_scenario(self.ctx, extra_days=5)
+		make_purchase_return(early.pr_10, qty=5, posting_date="2026-01-23")
+		correct_rate_with_landed_cost(self.ctx, early.pr_10, 1000)
+
+		self.assertEqual(ledger_values(full.milk), ledger_values(early.milk))
+
+	def test_bin_matches_last_entry_after_early_exit(self):
+		self.skip_if_other_reposts_pending()
+
+		data = make_milk_scenario(self.ctx, extra_days=10)
+		correct_rate_with_landed_cost(self.ctx, data.pr_10, 1000)
+
+		last_sle = frappe.get_all(
+			"Stock Ledger Entry",
+			filters={"item_code": data.milk, "warehouse": self.ctx.warehouse, "is_cancelled": 0},
+			fields=["qty_after_transaction", "stock_value"],
+			order_by="posting_datetime desc, creation desc",
+			limit=1,
+		)[0]
+		bin_values = frappe.db.get_value(
+			"Bin",
+			{"item_code": data.milk, "warehouse": self.ctx.warehouse},
+			["actual_qty", "stock_value"],
+			as_dict=True,
+		)
+		self.assertEqual(flt(bin_values.actual_qty), flt(last_sle.qty_after_transaction))
+		self.assertEqual(flt(bin_values.stock_value), flt(last_sle.stock_value))
+
+	def skip_if_other_reposts_pending(self):
+		if frappe.db.exists(
+			"Repost Item Valuation",
+			{"docstatus": 1, "status": ("in", ("Queued", "In Progress", "Failed"))},
+		):
+			self.skipTest("Other reposts are pending or failed on this site, early exit stays off")
+
+
+# ---------------------------------------------------------------- helpers
+
+
+def get_context():
+	company = erpnext.get_default_company() or frappe.get_all("Company", pluck="name", limit=1)[0]
+	abbr = frappe.get_cached_value("Company", company, "abbr")
+	warehouse = frappe.db.get_value(
+		"Warehouse", {"company": company, "is_group": 0, "warehouse_name": "Stores"}
+	) or frappe.db.get_value("Warehouse", {"company": company, "is_group": 0})
+
+	return frappe._dict(
+		company=company,
+		abbr=abbr,
+		warehouse=warehouse,
+		supplier=get_or_make_party("Supplier", "Early Exit Test Supplier"),
+		customer=get_or_make_party("Customer", "Early Exit Test Customer"),
+	)
+
+
+def get_or_make_party(doctype, name):
+	if frappe.db.exists(doctype, name):
+		return name
+
+	doc = frappe.new_doc(doctype)
+	if doctype == "Supplier":
+		doc.supplier_name = name
+		doc.supplier_group = frappe.db.get_value("Supplier Group", {"is_group": 0})
+	else:
+		doc.customer_name = name
+		doc.customer_group = frappe.db.get_value("Customer Group", {"is_group": 0})
+		doc.territory = frappe.db.get_value("Territory", {"is_group": 0})
+	doc.insert(ignore_permissions=True)
+	return doc.name
+
+
+def make_test_item(prefix):
+	item_code = f"{prefix}-{frappe.generate_hash(length=6)}"
+	frappe.get_doc(
+		{
+			"doctype": "Item",
+			"item_code": item_code,
+			"item_name": item_code,
+			"item_group": frappe.db.get_value("Item Group", {"is_group": 0}),
+			"stock_uom": "Nos",
+			"is_stock_item": 1,
+			"include_item_in_manufacturing": 1,
+			"valuation_method": "FIFO",
+		}
+	).insert(ignore_permissions=True)
+	return item_code
+
+
+def make_milk_scenario(ctx, extra_days=0):
+	"""The task scenario. extra_days adds one receipt and one delivery of Milk per day after
+	the manufacture entry, to stand for the normal entries that come after a backdated change."""
+	milk = make_test_item("EE-Milk")
+	powder = make_test_item("EE-Milk-Powder")
+
+	make_stock_entry(
+		item_code=milk,
+		qty=100,
+		rate=50,
+		to_warehouse=ctx.warehouse,
+		company=ctx.company,
+		posting_date="2026-01-01",
+		posting_time=POSTING_TIME,
+	)
+	bom = make_bom(ctx, powder, milk)
+
+	data = frappe._dict(milk=milk, powder=powder)
+	data.pr_10 = make_purchase_receipt(ctx, milk, 50, 60, "2026-01-10")
+	data.dn_15 = make_delivery_note(ctx, milk, 80, "2026-01-15")
+	data.pr_20 = make_purchase_receipt(ctx, milk, 50, 60, "2026-01-20")
+	data.mfg_21 = make_manufacture_entry(ctx, bom, 10, "2026-01-21")
+	data.dn_25 = make_delivery_note(ctx, powder, 10, "2026-01-25")
+
+	for day in range(extra_days):
+		posting_date = add_days("2026-01-22", day)
+		make_purchase_receipt(ctx, milk, 10, 60, posting_date)
+		make_delivery_note(ctx, milk, 10, posting_date)
+
+	return data
+
+
+def make_bom(ctx, item, raw_material):
+	bom = frappe.get_doc(
+		{
+			"doctype": "BOM",
+			"item": item,
+			"company": ctx.company,
+			"quantity": 10,
+			"rm_cost_as_per": "Valuation Rate",
+			"items": [{"item_code": raw_material, "qty": 100}],
+		}
+	)
+	bom.insert(ignore_permissions=True)
+	bom.submit()
+	return bom.name
+
+
+def make_purchase_receipt(ctx, item_code, qty, rate, posting_date):
+	pr = frappe.get_doc(
+		{
+			"doctype": "Purchase Receipt",
+			"company": ctx.company,
+			"supplier": ctx.supplier,
+			"set_posting_time": 1,
+			"posting_date": posting_date,
+			"posting_time": POSTING_TIME,
+			"set_warehouse": ctx.warehouse,
+			"items": [{"item_code": item_code, "qty": qty, "rate": rate, "warehouse": ctx.warehouse}],
+		}
+	)
+	pr.insert(ignore_permissions=True)
+	pr.submit()
+	return pr
+
