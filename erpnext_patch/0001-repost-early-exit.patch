+def make_delivery_note(ctx, item_code, qty, posting_date):
+	dn = frappe.get_doc(
+		{
+			"doctype": "Delivery Note",
+			"company": ctx.company,
+			"customer": ctx.customer,
+			"set_posting_time": 1,
+			"posting_date": posting_date,
+			"posting_time": POSTING_TIME,
+			"set_warehouse": ctx.warehouse,
+			"items": [{"item_code": item_code, "qty": qty, "rate": 100, "warehouse": ctx.warehouse}],
