@@ -0,0 +1,62 @@
+"""Compare a full repost with the early exit on the Milk / Milk Powder scenario.
+
+Run on a test site:
+
+    bench --site <site> execute erpnext.stock.tests.repost_early_exit_benchmark.run --kwargs "{'extra_days': 100}"
+
+For each mode it builds the task scenario plus `extra_days` days of normal Milk entries after
+the manufacture entry, corrects the 10 Jan receipt from 60 to 80 with a Landed Cost Voucher,
+and prints how many later stock ledger entries were written and how long the submit took.
+Everything is rolled back at the end, so the site is left as it was.
+"""
+
+import time
+
+import frappe
+
+from erpnext.stock.tests.test_repost_early_exit import (
+	correct_rate_with_landed_cost,
+	get_context,
+	ledger_values,
+	make_milk_scenario,
+)
+
+
+def run(extra_days=100):
+	extra_days = int(extra_days)
+	pending = frappe.db.exists(
+		"Repost Item Valuation", {"docstatus": 1, "status": ("in", ("Queued", "In Progress", "Failed"))}
+	)
+	if pending:
+		print("Note: other reposts are queued or failed on this site, so early exit stays off.")
+
+	# in_test makes the repost run right away when the Landed Cost Voucher is submitted
+	# and stops the repost from committing, so everything can be rolled back.
+	frappe.flags.in_test = True
+	try:
+		ctx = get_context()
+		results = []
+		for label, disabled in (("Full repost (today)", True), ("Early exit (patch)", False)):
+			frappe.flags.disable_repost_early_exit = disabled
+			data = make_milk_scenario(ctx, extra_days=extra_days)
+
+			started = time.perf_counter()
+			run = correct_rate_with_landed_cost(ctx, data.pr_10, 1000)
+			seconds = time.perf_counter() - started
+
+			results.append((label, run, seconds, ledger_values(data.milk), ledger_values(data.powder)))
+
+		print()
+		print(f"Later Milk entries after the manufacture entry: {extra_days * 2}")
+		print(f"{'Mode':<24}{'Recalculated':>14}{'Skipped':>10}{'Seconds':>10}")
+		for label, run, seconds, *_ in results:
+			print(f"{label:<24}{run.processed:>14}{run.skipped:>10}{seconds:>10.2f}")
+
+		same = results[0][3] == results[1][3] and results[0][4] == results[1][4]
+		print(f"Both ledgers identical: {'yes' if same else 'NO'}")
+		if results[1][1].pending_reposts:
+			print(f"Early exit was off because of: {', '.join(results[1][1].pending_reposts)}")
+	finally:
+		frappe.flags.disable_repost_early_exit = False
+		frappe.flags.in_test = False
+		frappe.db.rollback()
