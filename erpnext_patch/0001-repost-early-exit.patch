+def correct_rate_with_landed_cost(ctx, pr, amount):
+	"""Correct the receipt's rate the way it is done in production: a Landed Cost Voucher.
+	Returns what the reposts did: entries processed and skipped, and why early exit was off."""
+	expense_account = frappe.get_cached_value(
+		"Company", ctx.company, "expenses_included_in_valuation"
+	) or f"Expenses Included In Valuation - {ctx.abbr}"
+
+	lcv = frappe.get_doc(
+		{
+			"doctype": "Landed Cost Voucher",
+			"company": ctx.company,
+			"distribute_charges_based_on": "Amount",
+			"purchase_receipts": [
+				{
+					"receipt_document_type": "Purchase Receipt",
+					"receipt_document": pr.name,
+					"supplier": pr.supplier,
+					"posting_date": pr.posting_date,
+					"grand_total": pr.base_grand_total,
+				}
+			],
+			"taxes": [
+				{
+					"description": "Rate correction",
+					"expense_account": expense_account,
+					"amount": amount,
+				}
+			],
+		}
+	)
+
+	frappe.flags.repost_early_exit_stats = []
+	try:
+		lcv.insert(ignore_permissions=True)
+		lcv.submit()  # queues a Repost Item Valuation; in tests it runs right away
+		if not frappe.flags.in_test:
+			run_pending_reposts_for(pr)
+		stats = frappe.flags.repost_early_exit_stats
+	finally:
+		frappe.flags.repost_early_exit_stats = None
+
+	return frappe._dict(
+		reposts=len(stats),
+		early_exit_enabled=bool(stats) and all(row.early_exit_enabled for row in stats),
+		processed=sum(row.processed for row in stats),
+		skipped=sum(row.skipped for row in stats),
+		pending_reposts=sorted({name for row in stats for name in row.pending_reposts}),
+		trace=[entry for row in stats for entry in row.trace],
+	)
+
+
+def landed_cost_based_on_purchase_invoice():
+	return bool(
+		frappe.db.get_single_value("Buying Settings", "set_landed_cost_based_on_purchase_invoice_rate")
+	)
+
+
+def run_pending_reposts_for(pr):
+	from erpnext.stock.doctype.repost_item_valuation.repost_item_valuation import repost
+
+	for name in frappe.get_all(
+		"Repost Item Valuation",
+		filters={"voucher_no": pr.name, "docstatus": 1, "status": "Queued"},
+		pluck="name",
+	):
+		repost(frappe.get_doc("Repost Item Valuation", name))
+
+
+def get_sle(voucher_no, item_code):
+	return frappe.get_all(
+		"Stock Ledger Entry",
+		filters={"voucher_no": voucher_no, "item_code": item_code, "is_cancelled": 0},
+		fields=list(SLE_FIELDS),
+		limit=1,
+	)[0]
+
+
+def ledger_values(item_code):
+	"""The ledger of an item, without voucher names, so two runs can be compared."""
+	rows = frappe.get_all(
+		"Stock Ledger Entry",
+		filters={"item_code": item_code, "is_cancelled": 0},
+		fields=["posting_date", *SLE_FIELDS],
+		order_by="posting_datetime asc, creation asc",
+	)
+	return [
+		(
+			getdate(row.posting_date),
+			row.voucher_type,
+			flt(row.actual_qty, 6),
+			flt(row.qty_after_transaction, 6),
+			flt(row.valuation_rate, 6),
+			flt(row.stock_value, 2),
+			flt(row.stock_value_difference, 2),
+			tuple((flt(qty, 6), flt(rate, 6)) for qty, rate in json.loads(row.stock_queue or "[]")),
+		)
+		for row in rows
+	]
